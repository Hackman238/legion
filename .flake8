[flake8]
# E501/W291 (line length / trailing whitespace) are intentionally not
# gated: the tree carries hundreds of pre-existing style-only hits
# (generated UI code, long SQL/command literals). The gate below keeps
# the correctness codes at zero; style cleanup is tracked separately.
select=F811,F823,F831,F841,E502,E703,E704,E713,E741,E742,E743,W601,W602
exclude=.git,.idea,tmp,backup,log,images,venv,.venv
max-line-length = 120